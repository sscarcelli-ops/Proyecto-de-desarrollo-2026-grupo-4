# Copiar como backend/.env (no se versiona). Spring Boot lo carga al arrancar desde la carpeta backend/.

# Perfil activo: dev | dev,seed (con datos de prueba, contraseña Prueba123) | prod
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
# También los usa docker compose (--env-file backend/.env) para crear el contenedor
DB_HOST=localhost
# Si tenés PostgreSQL instalado usando el 5432, poné 5433
DB_PORT=5432
# accesos_db (de trabajo) | accesos_vacia (sin datos de prueba, para US-01)
DB_NAME=accesos_db
DB_USER=postgres
DB_PASSWORD=postgres

# ==========================================
# SERVIDOR
# ==========================================
PORT=8080
# Orígenes que pueden llamar a la API desde otra dirección, separados por comas. La app no lo necesita (llama a /api
# en su misma dirección y Vite o nginx lo reenvían); queda para herramientas que corren en otra dirección.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Zona horaria del sistema: qué es "hoy" para los vencimientos y la hora de los movimientos. Nombre IANA.
ZONA_HORARIA=America/Argentina/Buenos_Aires

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
# Mínimo 32 caracteres (256 bits). Cada entorno usa la suya; nunca se versiona la real.
JWT_SECRET=tu_clave_secreta_super_segura_de_al_menos_256_bits
# Duración del token en segundos: 28800 = 8 horas (una jornada de trabajo)
JWT_EXPIRATION_SECONDS=28800

# ==========================================
# ACTIVACIÓN DEL ADMINISTRADOR (US-01)
# ==========================================
# Código que se ingresa en /activar para crear el primer Administrador (manual de instalación).
# Se carga al arrancar si todavía no hay Administrador; sirve una sola vez. En una instalación real,
# reemplazarlo por un valor propio antes del primer arranque. Para uno nuevo: cambiarlo y reiniciar.
ACTIVACION_TOKEN=GRUPO4-ACTIVAR-2026
# Días de vigencia desde el primer arranque con ese código
ACTIVACION_VIGENCIA_DIAS=30

# ==========================================
# CORREO (T-04) Y RECUPERAR CONTRASEÑA (US-06)
# ==========================================
# Servidor SMTP. Vacío: no se envía y el contenido del correo se muestra en el log del backend (solo fuera de prod).
# En los ambientes de prueba de Docker se usa Mailpit (MAIL_HOST=mailpit): los correos se ven en http://localhost:8025.
# Desde el IDE, con Mailpit levantado (docker compose --env-file backend/.env up -d postgres mailpit): MAIL_HOST=localhost.
# Para un servidor real (ej. Gmail): MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_USERNAME, MAIL_PASSWORD (contraseña
# de aplicación), MAIL_SMTP_AUTH=true y MAIL_SMTP_STARTTLS=true.
MAIL_HOST=
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=false
MAIL_SMTP_STARTTLS=false
MAIL_FROM=no-responder@accesos.local
# Dirección de la app que abre el usuario: con ella se arma el enlace del correo
APP_URL=http://localhost:5173
# Minutos que vale el enlace para recuperar la contraseña
RECUPERO_VIGENCIA_MINUTOS=30

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (RNF-10)
# ==========================================
# Carpeta base; en la BD solo se guarda la ruta relativa. En Docker/servidor: /data/archivos
STORAGE_PATH=./uploads

# ==========================================
# LOGS (T-10)
# ==========================================
# Nivel general y de los mensajes propios de la app: ERROR | WARN | INFO | DEBUG
LOG_LEVEL=INFO
LOG_LEVEL_APP=INFO
# Solo con el perfil dev: las consultas SQL de Hibernate (DEBUG las muestra, INFO las oculta)
LOG_LEVEL_SQL=DEBUG
# Archivo de log además de la consola (vacío: solo consola). Rota al llegar al tamaño y guarda los días indicados.
# En Docker ya se guarda en el volumen "logs" (/data/logs/accesos.log).
LOG_FILE=
LOG_FILE_MAX_SIZE=10MB
LOG_FILE_MAX_DAYS=14

# ==========================================
# PAGINACIÓN (RNF-08)
# ==========================================
PAGE_SIZE=20

# ==========================================
# DOCKER
# ==========================================
# Este archivo es para el desarrollo. Los ambientes todo en Docker (Prueba con datos, Prueba vacía y Producción) tienen
# su propio archivo en docker/ y toman de acá solo los valores por defecto: ver la tabla "Ambientes" del README.
