# Copiar como backend/.env (no se versiona). Spring Boot lo carga al arrancar desde la carpeta backend/.

# Perfil activo: dev | dev,seed (con datos de prueba, contraseña Prueba123) | prod
SPRING_PROFILES_ACTIVE=dev

# ==========================================
# BASE DE DATOS (PostgreSQL)
# ==========================================
# También los usa docker compose (--env-file backend/.env) para crear el contenedor
DB_HOST=localhost
# Si tenés PostgreSQL instalado usando el 5432, poné 5433
DB_PORT=5432
# accesos_db (de trabajo) | accesos_vacia (sin datos de prueba, para US-01)
DB_NAME=accesos_db
DB_USER=postgres
DB_PASSWORD=postgres

# ==========================================
# SERVIDOR
# ==========================================
PORT=8080
# Separar con comas si hay más de un origen
CORS_ALLOWED_ORIGINS=http://localhost:5173

# ==========================================
# SEGURIDAD Y JWT
# ==========================================
# Mínimo 32 caracteres (256 bits). Cada entorno usa la suya; nunca se versiona la real.
JWT_SECRET=tu_clave_secreta_super_segura_de_al_menos_256_bits
# Duración del token en segundos: 28800 = 8 horas (una jornada de trabajo)
JWT_EXPIRATION_SECONDS=28800

# ==========================================
# ALMACENAMIENTO DE ARCHIVOS (RNF-10)
# ==========================================
# Carpeta base; en la BD solo se guarda la ruta relativa. En Docker/servidor: /data/archivos
STORAGE_PATH=./uploads

# ==========================================
# PAGINACIÓN (RNF-08)
# ==========================================
PAGE_SIZE=20
