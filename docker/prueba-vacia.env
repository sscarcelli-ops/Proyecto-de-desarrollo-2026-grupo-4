# Ambiente de PRUEBA, VACÍA: todo en Docker, sin datos de prueba y sin Administrador. Para el camino feliz desde cero:
# activar el primer Administrador (US-01) en http://localhost:5173/activar con el código GRUPO4-ACTIVAR-2026 y cargar
# todo desde ahí.
#   docker compose --env-file docker/prueba-vacia.env up -d --build
# Usa su propia base (accesos_vacia): pasar de un ambiente de prueba al otro no borra los datos de ninguno.
# Para repetir el camino feliz desde cero: docker compose down -v (borra las dos bases; la del seed se vuelve a cargar
# sola al levantar Prueba con datos).

# Este mismo archivo pasa sus variables al backend (docker-compose.yml)
DOCKER_AMBIENTE=docker/prueba-vacia.env

DOCKER_BASE=accesos_vacia
DOCKER_PERFILES=dev

# Sin las consultas SQL en el log: así se ven los rechazos y los errores
LOG_LEVEL_SQL=INFO
