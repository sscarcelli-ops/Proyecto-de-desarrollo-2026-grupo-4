# Ambiente de PRUEBA, CON DATOS: todo en Docker, con los usuarios y datos del seed. Para ejecutar los casos de prueba.
#   docker compose --env-file docker/prueba.env up -d --build
# Es el ambiente por defecto: "docker compose up -d --build" (sin --env-file) hace lo mismo.
# El resto de la configuración sale de backend/.env.example, que funciona tal cual para probar.

# Este mismo archivo pasa sus variables al backend (docker-compose.yml)
DOCKER_AMBIENTE=docker/prueba.env

# Base de trabajo con el seed (dev,seed). Los usuarios y la contraseña están en el README.
DOCKER_BASE=accesos_db
DOCKER_PERFILES=dev,seed

# Sin las consultas SQL en el log: así se ven los rechazos y los errores
LOG_LEVEL_SQL=INFO

# Correo (T-04): Mailpit recibe los correos del sistema (recuperar contraseña) y los muestra en http://localhost:8025.
# COMPOSE_PROFILES levanta su contenedor. Sin --env-file no se levanta: el contenido del correo queda en el log del backend.
COMPOSE_PROFILES=correo
MAIL_HOST=mailpit
MAIL_PORT=1025
