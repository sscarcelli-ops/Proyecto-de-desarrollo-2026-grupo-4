# Opcional: copiar como frontend/.env (no se versiona) solo si el backend o el puerto no son los de siempre.
# Son variables del servidor de desarrollo (npm run dev): no llevan el prefijo VITE_ y no llegan al navegador.
# El frontend llama a /api en su misma dirección y Vite reenvía esos pedidos a BACKEND_URL. En Docker lo hace nginx,
# con la variable BACKEND_URL del docker-compose.yml.

# Dirección del backend (sin /api al final)
BACKEND_URL=http://localhost:8080
# Puerto del frontend. Si está ocupado, Vite usa el siguiente libre
FRONTEND_PORT=5173
