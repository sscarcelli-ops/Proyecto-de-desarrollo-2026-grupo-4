# Sirve la app compilada y reenvía /api al backend (T-09, T-12).
# Es una plantilla: al arrancar, la imagen de nginx reemplaza ${BACKEND_URL} por la variable de entorno del contenedor
# (docker-compose.yml) y la deja en /etc/nginx/conf.d/default.conf. Las variables propias de nginx ($uri, $host...)
# no se tocan porque no existen como variables de entorno.
server {
    listen 80;
    root /usr/share/nginx/html;
    index index.html;

    # El frontend llama a /api en su misma dirección (shared/lib/httpClient.ts): no sabe dónde está el backend.
    # Sin barra al final de proxy_pass, el pedido llega al backend con la misma ruta (/api/...).
    location /api/ {
        proxy_pass ${BACKEND_URL};
        # Host con el puerto ($http_host, no $host): el backend ve la misma dirección que el navegador
        # (localhost:5173, el dominio de la VPS...) y trata el pedido como del mismo sitio. Con $host el puerto se
        # pierde y el backend lo rechaza por CORS (403) en cualquier puerto o dominio que no esté en
        # CORS_ALLOWED_ORIGINS.
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Mismo límite que el backend para el alta de un trabajador con ART + Seguro + foto (application.yml).
        # Sin esto nginx corta en 1 MB y los PDF no llegan al backend.
        client_max_body_size 20m;
    }

    # Cualquier dirección que no sea un archivo devuelve index.html: así funcionan las rutas de React (/barrios,
    # /garita...) aunque se recargue la página o se escriban en la barra de direcciones.
    location / {
        try_files $uri /index.html;
    }

    # Los archivos de assets/ llevan un hash en el nombre: se pueden guardar en caché sin vencimiento
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }
}
